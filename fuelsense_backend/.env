# ── Email (Gmail SMTP) ─────────────────────────────────────────────────────
# Signup verification codes and password-reset codes are emailed from here.
#
# The values below are PLACEHOLDERS. While they are left as-is the backend
# prints the code to the runserver console instead of sending mail, and the
# API also returns it as "dev_otp" because OTP_DEV_MODE is on.
#
# To send real email:
#   1. Turn on 2-Step Verification for the Gmail account
#   2. Create a 16-character App Password: https://myaccount.google.com/apppasswords
#   3. Replace the two values below (keep the spaces out of the app password)
EMAIL_HOST_USER=zuhaibamin11@gmail.com
EMAIL_HOST_PASSWORD=Zuhaib.amin23

# ── Development flags ──────────────────────────────────────────────────────
# OTP_DEV_MODE=True returns the code in the API response ("dev_otp") so signup
# and password reset can be demoed without a working mailbox.
# Both of these MUST be flipped before deploying.
OTP_DEV_MODE=True
DJANGO_DEBUG=True

# ── Detector ───────────────────────────────────────────────────────────────
# Shared secret the YOLO client sends with POST /api/update_queue/
DETECTION_API_KEY=fuelsense2024
